{"version":1,"unified_memory":true,"debugger_open":false,"trace_enabled":false,"serial_terminal_open":false,"serial_input_ending":0,"serial_file_ending":0,"serial_file_line_delay_ms":0,"cpu_model":"8051","hardware_module":"","peripheral_devices":[{"id":"covox","kind":2,"address":32768,"reference_volts":5,"voltage":2.5,"conversion_ticks":768,"digital_value":0,"audio_directions":2,"input_gain_db":0},{"id":"audio","kind":5,"address":32768,"reference_volts":5,"voltage":2.5,"conversion_ticks":768,"digital_value":0,"audio_directions":2,"input_gain_db":0}],"peripheral_digital_wires":[{"a":"cpu.P1","b":"covox.data","a_bit":0,"b_bit":0,"width":8}],"peripheral_analog_wires":[{"from":"covox.out","to":"audio.playback"}],"cycle_exact":true,"crystal_mhz":24.576000000000001,"instructions_per_frame":500,"programs":[{"path":"covox_duet.asm","binary_address":0,"from_editor":true,"source_text":"; SPDX-License-Identifier: GPL-2.0-only\n; Two interrupt-driven square-wave voices -> P1 -> Covox -> audio output.\n; 8051, 24.576 MHz crystal, Cycle exact. No ADC or microphone is used.\n; T0 mode 2: 2.048 MHz / 256 = 8000 samples/s, high priority.\n; T1 mode 1: nominal 100 Hz music tick (small software-reload overhead).\n; Song is in code memory: duration ticks, MIDI pitch 1, gate 1, pitch 2, gate 2.\n; Pitch range C3..B5 (MIDI 48..83). Gates: 0=off, nonzero=on.\n; A zero duration loops the song. Every record retriggers both phases.\n; Each gated voice contributes +/-63; mix = 128 + voice1 + voice2 (2..254).\n; DDS frequency = step * 8000 / 65536; no waveform lookup in the audio ISR.\n;\n; Internal RAM player status (hex addresses, little-endian words):\n; 30 playing; 31..32 music ticks; 33 current row (1-based); 34 Covox byte;\n; 35..36 sample count; 37 loop count (all counters wrap).\n; 38..39 voice 1 phase; 3A..3B step; 3C pitch; 3D gate; 3E signed sample.\n; 40..41 voice 2 phase; 42..43 step; 44 pitch; 45 gate; 46 signed sample.\n; 48..49 next song record; 4A ticks left; 4C..53 pending note data.\n; Bank 0=main, bank 1=T0, bank 2=T1; stack 60h..7Fh (SP starts at 5Fh).\n; T1 calculates pitches first, then briefly masks ET0 for an atomic two-voice\n; update. T0 otherwise preempts T1 and never touches its DPTR/register bank.\n$MOD51\nPLAYING EQU 030h\nMUSIC_TICKS_LO EQU 031h\nMUSIC_TICKS_HI EQU 032h\nSONG_ROW EQU 033h\nLAST_SAMPLE EQU 034h\nSAMPLES_LO EQU 035h\nSAMPLES_HI EQU 036h\nSONG_LOOPS EQU 037h\nV1_PHASE_LO EQU 038h\nV1_PHASE_HI EQU 039h\nV1_STEP_LO EQU 03Ah\nV1_STEP_HI EQU 03Bh\nV1_PITCH EQU 03Ch\nV1_GATE EQU 03Dh\nV1_SAMPLE EQU 03Eh\nV2_PHASE_LO EQU 040h\nV2_PHASE_HI EQU 041h\nV2_STEP_LO EQU 042h\nV2_STEP_HI EQU 043h\nV2_PITCH EQU 044h\nV2_GATE EQU 045h\nV2_SAMPLE EQU 046h\nSONG_PTR_LO EQU 048h\nSONG_PTR_HI EQU 049h\nTICKS_LEFT EQU 04Ah\nNEXT_PITCH1 EQU 04Ch\nNEXT_GATE1 EQU 04Dh\nNEXT_STEP1_LO EQU 04Eh\nNEXT_STEP1_HI EQU 04Fh\nNEXT_PITCH2 EQU 050h\nNEXT_GATE2 EQU 051h\nNEXT_STEP2_LO EQU 052h\nNEXT_STEP2_HI EQU 053h\n\norg 0000h\n    ljmp start\norg 000Bh\n    ljmp audio_isr\norg 001Bh\n    ljmp music_isr\norg 0100h\nstart:\n    mov IE,#0\n    mov SP,#05Fh\n    mov P1,#080h\n    mov R0,#030h\n    mov R7,#36\nclear_status:\n    mov @R0,#0\n    inc R0\n    djnz R7,clear_status\n    mov LAST_SAMPLE,#080h\n    mov DPTR,#song\n    mov SONG_PTR_LO,DPL\n    mov SONG_PTR_HI,DPH\n    mov PLAYING,#1\n    mov TMOD,#012h       ; T1: 16-bit; T0: 8-bit auto reload.\n    mov TH0,#0\n    mov TL0,#0\n    mov TH1,#0B0h        ; 65536-20480: nominal 10 ms at 2.048 MHz.\n    mov TL1,#0\n    mov IP,#002h        ; PT0 high, PT1 low: audio can interrupt sequencing.\n    mov TCON,#050h       ; TR1 + TR0, clear old flags.\n    mov IE,#08Ah         ; EA + ET1 + ET0.\nidle:\n    sjmp idle\n\n; Sample generator: bounded work, no song reads or division.\naudio_isr:\n    push ACC\n    push PSW\n    mov PSW,#008h       ; Register bank 1.\n    mov A,V1_PHASE_LO\n    add A,V1_STEP_LO\n    mov V1_PHASE_LO,A\n    mov A,V1_PHASE_HI\n    addc A,V1_STEP_HI\n    mov V1_PHASE_HI,A\n    mov V1_SAMPLE,#0\n    mov A,V1_GATE\n    jz voice1_done\n    mov A,V1_PHASE_HI\n    jb 0E7h,voice1_negative\n    mov V1_SAMPLE,#63\n    sjmp voice1_done\nvoice1_negative:\n    mov V1_SAMPLE,#0C1h  ; -63, signed two's complement contribution.\nvoice1_done:\n    mov A,V2_PHASE_LO\n    add A,V2_STEP_LO\n    mov V2_PHASE_LO,A\n    mov A,V2_PHASE_HI\n    addc A,V2_STEP_HI\n    mov V2_PHASE_HI,A\n    mov V2_SAMPLE,#0\n    mov A,V2_GATE\n    jz voice2_done\n    mov A,V2_PHASE_HI\n    jb 0E7h,voice2_negative\n    mov V2_SAMPLE,#63\n    sjmp voice2_done\nvoice2_negative:\n    mov V2_SAMPLE,#0C1h\nvoice2_done:\n    mov A,#080h\n    add A,V1_SAMPLE\n    add A,V2_SAMPLE\ncovox_write:\n    mov P1,A            ; Both off = 80h, one voice = 41h/BFh, two = 02h/80h/FEh.\n    mov LAST_SAMPLE,A\n    inc SAMPLES_LO\n    mov A,SAMPLES_LO\n    jnz sample_count_done\n    inc SAMPLES_HI\nsample_count_done:\n    pop PSW\n    pop ACC\n    reti\n\n; Independent control interrupt: duration and pitch/gate events in code memory.\nmusic_isr:\n    push ACC\n    push PSW\n    push DPL\n    push DPH\n    mov PSW,#010h       ; Register bank 2; bank 1 remains private to audio.\n    clr TR1\n    mov TH1,#0B0h\n    mov TL1,#0\n    setb TR1\n    inc MUSIC_TICKS_LO\n    mov A,MUSIC_TICKS_LO\n    jnz tick_count_done\n    inc MUSIC_TICKS_HI\ntick_count_done:\n    mov A,TICKS_LEFT\n    jz next_record\n    dec TICKS_LEFT\n    mov A,TICKS_LEFT\n    jnz music_done\nnext_record:\n    mov R7,SONG_ROW     ; Next row index stays private until both voices commit.\n    mov DPL,SONG_PTR_LO\n    mov DPH,SONG_PTR_HI\n    clr A\n    movc A,@A+DPTR\n    jnz record_ready\n    mov DPTR,#song      ; Zero duration is the loop marker.\n    inc SONG_LOOPS\n    mov R7,#0\n    clr A\n    movc A,@A+DPTR\nrecord_ready:\n    mov TICKS_LEFT,A\n    inc DPTR\n    clr A\n    movc A,@A+DPTR\n    mov NEXT_PITCH1,A\n    inc DPTR\n    clr A\n    movc A,@A+DPTR\n    mov NEXT_GATE1,A\n    inc DPTR\n    clr A\n    movc A,@A+DPTR\n    mov NEXT_PITCH2,A\n    inc DPTR\n    clr A\n    movc A,@A+DPTR\n    mov NEXT_GATE2,A\n    inc DPTR\n    mov SONG_PTR_LO,DPL\n    mov SONG_PTR_HI,DPH\n    mov A,NEXT_PITCH1\n    lcall pitch_step\n    mov NEXT_STEP1_LO,R4\n    mov NEXT_STEP1_HI,R5\n    jnc pitch1_valid\n    mov NEXT_GATE1,#0\npitch1_valid:\n    mov A,NEXT_PITCH2\n    lcall pitch_step\n    mov NEXT_STEP2_LO,R4\n    mov NEXT_STEP2_HI,R5\n    jnc pitch2_valid\n    mov NEXT_GATE2,#0\npitch2_valid:\n    clr ET0             ; Publish a whole chord; never expose half a step word.\n    mov V1_PITCH,NEXT_PITCH1\n    mov V1_GATE,NEXT_GATE1\n    mov V1_STEP_LO,NEXT_STEP1_LO\n    mov V1_STEP_HI,NEXT_STEP1_HI\n    mov V2_PITCH,NEXT_PITCH2\n    mov V2_GATE,NEXT_GATE2\n    mov V2_STEP_LO,NEXT_STEP2_LO\n    mov V2_STEP_HI,NEXT_STEP2_HI\n    mov V1_PHASE_LO,#0\n    mov V1_PHASE_HI,#0\n    mov V2_PHASE_LO,#0\n    mov V2_PHASE_HI,#0\n    mov SONG_ROW,R7\n    inc SONG_ROW\nnotes_published:\n    setb ET0\nmusic_done:\n    pop DPH\n    pop DPL\n    pop PSW\n    pop ACC\n    reti\n\n; MIDI note -> 16-bit DDS step in R4:R5 (low:high), CY=1 for invalid pitch.\npitch_step:\n    clr C\n    subb A,#48\n    jc invalid_pitch\n    cjne A,#36,pitch_range\npitch_range:\n    jnc invalid_pitch\n    add A,ACC\n    mov R2,A\n    mov DPTR,#pitch_table\n    movc A,@A+DPTR\n    mov R4,A\n    inc DPTR\n    mov A,R2\n    movc A,@A+DPTR\n    mov R5,A\n    clr C\n    ret\ninvalid_pitch:\n    mov R4,#0\n    mov R5,#0\n    setb C\n    ret\n\n; Little-endian round(440 * 2^((MIDI-69)/12) * 65536 / 8000).\npitch_table:\n    db 48,4        ; MIDI 48\n    db 111,4        ; MIDI 49\n    db 179,4        ; MIDI 50\n    db 250,4        ; MIDI 51\n    db 70,5        ; MIDI 52\n    db 150,5        ; MIDI 53\n    db 235,5        ; MIDI 54\n    db 70,6        ; MIDI 55\n    db 165,6        ; MIDI 56\n    db 10,7        ; MIDI 57\n    db 117,7        ; MIDI 58\n    db 231,7        ; MIDI 59\n    db 95,8        ; MIDI 60\n    db 223,8        ; MIDI 61\n    db 102,9        ; MIDI 62\n    db 245,9        ; MIDI 63\n    db 140,10        ; MIDI 64\n    db 45,11        ; MIDI 65\n    db 215,11        ; MIDI 66\n    db 139,12        ; MIDI 67\n    db 74,13        ; MIDI 68\n    db 20,14        ; MIDI 69\n    db 235,14        ; MIDI 70\n    db 206,15        ; MIDI 71\n    db 190,16        ; MIDI 72\n    db 189,17        ; MIDI 73\n    db 203,18        ; MIDI 74\n    db 234,19        ; MIDI 75\n    db 25,21        ; MIDI 76\n    db 90,22        ; MIDI 77\n    db 174,23        ; MIDI 78\n    db 22,25        ; MIDI 79\n    db 148,26        ; MIDI 80\n    db 41,28        ; MIDI 81\n    db 214,29        ; MIDI 82\n    db 156,31        ; MIDI 83\n\n; An original repeating dyad exercise. Duration is in nominal 10 ms ticks.\n;                ticks, pitch1, gate1, pitch2, gate2\nsong:\n    db 25,60,1,52,1      ; C4 + E3\n    db 25,64,1,55,1      ; E4 + G3\n    db 25,67,1,60,1      ; G4 + C4\n    db 25,72,1,64,1      ; C5 + E4\n    db 25,71,1,62,1      ; B4 + D4\n    db 25,67,1,59,1      ; G4 + B3\n    db 25,64,1,55,1      ; E4 + G3\n    db 10,60,0,48,0      ; Both gates off (silence).\n    db 25,65,1,57,1      ; F4 + A3\n    db 25,69,1,60,1      ; A4 + C4\n    db 25,72,1,65,1      ; C5 + F4\n    db 25,69,1,60,1      ; A4 + C4\n    db 25,67,1,59,1      ; G4 + B3\n    db 25,64,1,55,1      ; E4 + G3\n    db 50,60,1,52,1      ; Hold C4 + E3.\n    db 25,60,0,48,1      ; Voice 2 alone.\n    db 25,72,1,48,0      ; Voice 1 alone.\n    db 50,60,0,48,0      ; Rest, then loop.\nsong_end:\n    db 0\nend\n"}],"reload_program":"","reload_binary_address":0,"editor":{"present":true,"open":true,"draft":true,"path":"","name":"covox_duet.asm","base_directory":".","text":"; SPDX-License-Identifier: GPL-2.0-only\n; Two interrupt-driven square-wave voices -> P1 -> Covox -> audio output.\n; 8051, 24.576 MHz crystal, Cycle exact. No ADC or microphone is used.\n; T0 mode 2: 2.048 MHz / 256 = 8000 samples/s, high priority.\n; T1 mode 1: nominal 100 Hz music tick (small software-reload overhead).\n; Song is in code memory: duration ticks, MIDI pitch 1, gate 1, pitch 2, gate 2.\n; Pitch range C3..B5 (MIDI 48..83). Gates: 0=off, nonzero=on.\n; A zero duration loops the song. Every record retriggers both phases.\n; Each gated voice contributes +/-63; mix = 128 + voice1 + voice2 (2..254).\n; DDS frequency = step * 8000 / 65536; no waveform lookup in the audio ISR.\n;\n; Internal RAM player status (hex addresses, little-endian words):\n; 30 playing; 31..32 music ticks; 33 current row (1-based); 34 Covox byte;\n; 35..36 sample count; 37 loop count (all counters wrap).\n; 38..39 voice 1 phase; 3A..3B step; 3C pitch; 3D gate; 3E signed sample.\n; 40..41 voice 2 phase; 42..43 step; 44 pitch; 45 gate; 46 signed sample.\n; 48..49 next song record; 4A ticks left; 4C..53 pending note data.\n; Bank 0=main, bank 1=T0, bank 2=T1; stack 60h..7Fh (SP starts at 5Fh).\n; T1 calculates pitches first, then briefly masks ET0 for an atomic two-voice\n; update. T0 otherwise preempts T1 and never touches its DPTR/register bank.\n$MOD51\nPLAYING EQU 030h\nMUSIC_TICKS_LO EQU 031h\nMUSIC_TICKS_HI EQU 032h\nSONG_ROW EQU 033h\nLAST_SAMPLE EQU 034h\nSAMPLES_LO EQU 035h\nSAMPLES_HI EQU 036h\nSONG_LOOPS EQU 037h\nV1_PHASE_LO EQU 038h\nV1_PHASE_HI EQU 039h\nV1_STEP_LO EQU 03Ah\nV1_STEP_HI EQU 03Bh\nV1_PITCH EQU 03Ch\nV1_GATE EQU 03Dh\nV1_SAMPLE EQU 03Eh\nV2_PHASE_LO EQU 040h\nV2_PHASE_HI EQU 041h\nV2_STEP_LO EQU 042h\nV2_STEP_HI EQU 043h\nV2_PITCH EQU 044h\nV2_GATE EQU 045h\nV2_SAMPLE EQU 046h\nSONG_PTR_LO EQU 048h\nSONG_PTR_HI EQU 049h\nTICKS_LEFT EQU 04Ah\nNEXT_PITCH1 EQU 04Ch\nNEXT_GATE1 EQU 04Dh\nNEXT_STEP1_LO EQU 04Eh\nNEXT_STEP1_HI EQU 04Fh\nNEXT_PITCH2 EQU 050h\nNEXT_GATE2 EQU 051h\nNEXT_STEP2_LO EQU 052h\nNEXT_STEP2_HI EQU 053h\n\norg 0000h\n    ljmp start\norg 000Bh\n    ljmp audio_isr\norg 001Bh\n    ljmp music_isr\norg 0100h\nstart:\n    mov IE,#0\n    mov SP,#05Fh\n    mov P1,#080h\n    mov R0,#030h\n    mov R7,#36\nclear_status:\n    mov @R0,#0\n    inc R0\n    djnz R7,clear_status\n    mov LAST_SAMPLE,#080h\n    mov DPTR,#song\n    mov SONG_PTR_LO,DPL\n    mov SONG_PTR_HI,DPH\n    mov PLAYING,#1\n    mov TMOD,#012h       ; T1: 16-bit; T0: 8-bit auto reload.\n    mov TH0,#0\n    mov TL0,#0\n    mov TH1,#0B0h        ; 65536-20480: nominal 10 ms at 2.048 MHz.\n    mov TL1,#0\n    mov IP,#002h        ; PT0 high, PT1 low: audio can interrupt sequencing.\n    mov TCON,#050h       ; TR1 + TR0, clear old flags.\n    mov IE,#08Ah         ; EA + ET1 + ET0.\nidle:\n    sjmp idle\n\n; Sample generator: bounded work, no song reads or division.\naudio_isr:\n    push ACC\n    push PSW\n    mov PSW,#008h       ; Register bank 1.\n    mov A,V1_PHASE_LO\n    add A,V1_STEP_LO\n    mov V1_PHASE_LO,A\n    mov A,V1_PHASE_HI\n    addc A,V1_STEP_HI\n    mov V1_PHASE_HI,A\n    mov V1_SAMPLE,#0\n    mov A,V1_GATE\n    jz voice1_done\n    mov A,V1_PHASE_HI\n    jb 0E7h,voice1_negative\n    mov V1_SAMPLE,#63\n    sjmp voice1_done\nvoice1_negative:\n    mov V1_SAMPLE,#0C1h  ; -63, signed two's complement contribution.\nvoice1_done:\n    mov A,V2_PHASE_LO\n    add A,V2_STEP_LO\n    mov V2_PHASE_LO,A\n    mov A,V2_PHASE_HI\n    addc A,V2_STEP_HI\n    mov V2_PHASE_HI,A\n    mov V2_SAMPLE,#0\n    mov A,V2_GATE\n    jz voice2_done\n    mov A,V2_PHASE_HI\n    jb 0E7h,voice2_negative\n    mov V2_SAMPLE,#63\n    sjmp voice2_done\nvoice2_negative:\n    mov V2_SAMPLE,#0C1h\nvoice2_done:\n    mov A,#080h\n    add A,V1_SAMPLE\n    add A,V2_SAMPLE\ncovox_write:\n    mov P1,A            ; Both off = 80h, one voice = 41h/BFh, two = 02h/80h/FEh.\n    mov LAST_SAMPLE,A\n    inc SAMPLES_LO\n    mov A,SAMPLES_LO\n    jnz sample_count_done\n    inc SAMPLES_HI\nsample_count_done:\n    pop PSW\n    pop ACC\n    reti\n\n; Independent control interrupt: duration and pitch/gate events in code memory.\nmusic_isr:\n    push ACC\n    push PSW\n    push DPL\n    push DPH\n    mov PSW,#010h       ; Register bank 2; bank 1 remains private to audio.\n    clr TR1\n    mov TH1,#0B0h\n    mov TL1,#0\n    setb TR1\n    inc MUSIC_TICKS_LO\n    mov A,MUSIC_TICKS_LO\n    jnz tick_count_done\n    inc MUSIC_TICKS_HI\ntick_count_done:\n    mov A,TICKS_LEFT\n    jz next_record\n    dec TICKS_LEFT\n    mov A,TICKS_LEFT\n    jnz music_done\nnext_record:\n    mov R7,SONG_ROW     ; Next row index stays private until both voices commit.\n    mov DPL,SONG_PTR_LO\n    mov DPH,SONG_PTR_HI\n    clr A\n    movc A,@A+DPTR\n    jnz record_ready\n    mov DPTR,#song      ; Zero duration is the loop marker.\n    inc SONG_LOOPS\n    mov R7,#0\n    clr A\n    movc A,@A+DPTR\nrecord_ready:\n    mov TICKS_LEFT,A\n    inc DPTR\n    clr A\n    movc A,@A+DPTR\n    mov NEXT_PITCH1,A\n    inc DPTR\n    clr A\n    movc A,@A+DPTR\n    mov NEXT_GATE1,A\n    inc DPTR\n    clr A\n    movc A,@A+DPTR\n    mov NEXT_PITCH2,A\n    inc DPTR\n    clr A\n    movc A,@A+DPTR\n    mov NEXT_GATE2,A\n    inc DPTR\n    mov SONG_PTR_LO,DPL\n    mov SONG_PTR_HI,DPH\n    mov A,NEXT_PITCH1\n    lcall pitch_step\n    mov NEXT_STEP1_LO,R4\n    mov NEXT_STEP1_HI,R5\n    jnc pitch1_valid\n    mov NEXT_GATE1,#0\npitch1_valid:\n    mov A,NEXT_PITCH2\n    lcall pitch_step\n    mov NEXT_STEP2_LO,R4\n    mov NEXT_STEP2_HI,R5\n    jnc pitch2_valid\n    mov NEXT_GATE2,#0\npitch2_valid:\n    clr ET0             ; Publish a whole chord; never expose half a step word.\n    mov V1_PITCH,NEXT_PITCH1\n    mov V1_GATE,NEXT_GATE1\n    mov V1_STEP_LO,NEXT_STEP1_LO\n    mov V1_STEP_HI,NEXT_STEP1_HI\n    mov V2_PITCH,NEXT_PITCH2\n    mov V2_GATE,NEXT_GATE2\n    mov V2_STEP_LO,NEXT_STEP2_LO\n    mov V2_STEP_HI,NEXT_STEP2_HI\n    mov V1_PHASE_LO,#0\n    mov V1_PHASE_HI,#0\n    mov V2_PHASE_LO,#0\n    mov V2_PHASE_HI,#0\n    mov SONG_ROW,R7\n    inc SONG_ROW\nnotes_published:\n    setb ET0\nmusic_done:\n    pop DPH\n    pop DPL\n    pop PSW\n    pop ACC\n    reti\n\n; MIDI note -> 16-bit DDS step in R4:R5 (low:high), CY=1 for invalid pitch.\npitch_step:\n    clr C\n    subb A,#48\n    jc invalid_pitch\n    cjne A,#36,pitch_range\npitch_range:\n    jnc invalid_pitch\n    add A,ACC\n    mov R2,A\n    mov DPTR,#pitch_table\n    movc A,@A+DPTR\n    mov R4,A\n    inc DPTR\n    mov A,R2\n    movc A,@A+DPTR\n    mov R5,A\n    clr C\n    ret\ninvalid_pitch:\n    mov R4,#0\n    mov R5,#0\n    setb C\n    ret\n\n; Little-endian round(440 * 2^((MIDI-69)/12) * 65536 / 8000).\npitch_table:\n    db 48,4        ; MIDI 48\n    db 111,4        ; MIDI 49\n    db 179,4        ; MIDI 50\n    db 250,4        ; MIDI 51\n    db 70,5        ; MIDI 52\n    db 150,5        ; MIDI 53\n    db 235,5        ; MIDI 54\n    db 70,6        ; MIDI 55\n    db 165,6        ; MIDI 56\n    db 10,7        ; MIDI 57\n    db 117,7        ; MIDI 58\n    db 231,7        ; MIDI 59\n    db 95,8        ; MIDI 60\n    db 223,8        ; MIDI 61\n    db 102,9        ; MIDI 62\n    db 245,9        ; MIDI 63\n    db 140,10        ; MIDI 64\n    db 45,11        ; MIDI 65\n    db 215,11        ; MIDI 66\n    db 139,12        ; MIDI 67\n    db 74,13        ; MIDI 68\n    db 20,14        ; MIDI 69\n    db 235,14        ; MIDI 70\n    db 206,15        ; MIDI 71\n    db 190,16        ; MIDI 72\n    db 189,17        ; MIDI 73\n    db 203,18        ; MIDI 74\n    db 234,19        ; MIDI 75\n    db 25,21        ; MIDI 76\n    db 90,22        ; MIDI 77\n    db 174,23        ; MIDI 78\n    db 22,25        ; MIDI 79\n    db 148,26        ; MIDI 80\n    db 41,28        ; MIDI 81\n    db 214,29        ; MIDI 82\n    db 156,31        ; MIDI 83\n\n; An original repeating dyad exercise. Duration is in nominal 10 ms ticks.\n;                ticks, pitch1, gate1, pitch2, gate2\nsong:\n    db 25,60,1,52,1      ; C4 + E3\n    db 25,64,1,55,1      ; E4 + G3\n    db 25,67,1,60,1      ; G4 + C4\n    db 25,72,1,64,1      ; C5 + E4\n    db 25,71,1,62,1      ; B4 + D4\n    db 25,67,1,59,1      ; G4 + B3\n    db 25,64,1,55,1      ; E4 + G3\n    db 10,60,0,48,0      ; Both gates off (silence).\n    db 25,65,1,57,1      ; F4 + A3\n    db 25,69,1,60,1      ; A4 + C4\n    db 25,72,1,65,1      ; C5 + F4\n    db 25,69,1,60,1      ; A4 + C4\n    db 25,67,1,59,1      ; G4 + B3\n    db 25,64,1,55,1      ; E4 + G3\n    db 50,60,1,52,1      ; Hold C4 + E3.\n    db 25,60,0,48,1      ; Voice 2 alone.\n    db 25,72,1,48,0      ; Voice 1 alone.\n    db 50,60,0,48,0      ; Rest, then loop.\nsong_end:\n    db 0\nend\n","line":0,"column":0},"breakpoints":[],"watchpoints":[],"watches":[],"peripheral_layout":[{"id":"cpu","x":0.0,"y":0.0,"name":""},{"id":"covox","x":157.88,"y":17.25,"name":""},{"id":"audio","x":315.38,"y":17.25,"name":""}],"peripheral_live_layout":[{"id":"audio","x":12,"y":46,"width":448,"height":304,"momentary_keys":false}],"peripheral_live_labels":[{"text":"Open playback, then Run to hear both voices.","x":12,"y":12}]}
