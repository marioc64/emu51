{"version":1,"unified_memory":true,"debugger_open":false,"trace_enabled":false,"serial_terminal_open":false,"serial_input_ending":0,"serial_file_ending":0,"serial_file_line_delay_ms":0,"cpu_model":"8051","hardware_module":"","peripheral_devices":[{"id":"adc","kind":1,"address":32768,"reference_volts":5,"voltage":2.5,"conversion_ticks":240,"digital_value":0,"audio_directions":2,"input_gain_db":0},{"id":"covox","kind":2,"address":32768,"reference_volts":5,"voltage":2.5,"conversion_ticks":768,"digital_value":0,"audio_directions":2,"input_gain_db":0},{"id":"ground","kind":3,"address":32768,"reference_volts":5,"voltage":0,"conversion_ticks":768,"digital_value":0,"audio_directions":2,"input_gain_db":0},{"id":"audio","kind":5,"address":32768,"reference_volts":5,"voltage":2.5,"conversion_ticks":768,"digital_value":0,"audio_directions":3,"input_gain_db":20}],"peripheral_digital_wires":[{"a":"adc.data","b":"cpu.P0","a_bit":0,"b_bit":0,"width":8},{"a":"cpu.P1","b":"covox.data","a_bit":0,"b_bit":0,"width":8},{"a":"cpu.P3","b":"adc.CS","a_bit":4,"b_bit":0,"width":1},{"a":"cpu.P3","b":"adc.WR","a_bit":5,"b_bit":0,"width":1},{"a":"cpu.P3","b":"adc.RD","a_bit":6,"b_bit":0,"width":1},{"a":"adc.INTR","b":"cpu.P3","a_bit":0,"b_bit":2,"width":1}],"peripheral_analog_wires":[{"from":"audio.capture","to":"adc.plus"},{"from":"ground.out","to":"adc.minus"},{"from":"covox.out","to":"audio.playback"}],"cycle_exact":true,"crystal_mhz":3,"instructions_per_frame":500,"programs":[{"path":"microphone_covox.asm","binary_address":0,"from_editor":true,"source_text":"; SPDX-License-Identifier: GPL-2.0-only\n; Microphone -> ADC0804 -> P0 -> circular echo buffer -> P1 -> Covox.\n; Use the microphone preset/project: 3 MHz crystal, Cycle exact, 8051 bank 0.\n; P3.4 = /CS, P3.5 = /WR, P3.6 = /RD, P3.2 = /INTR.\n; Each output = (input >> 1) + (old buffer byte >> 1), with logical shifts.\n; IRAM 30h = dry input, 31h = mixed output, 32h = buffer initialized flag.\n; DPTR = circular pointer; R4/R5 = exclusive end address; R7 = half input.\n; Silence is unsigned 80h. Initialize the delay line to silence, not zero.\n$MOD51\nECHO_BASE EQU 08000h\nBUFFER_SIZE EQU 4096     ; Delay in samples: change this (1..32767 bytes).\nECHO_END EQU ECHO_BASE+BUFFER_SIZE\norg 0\n    mov P0,#0FFh        ; Release all ADC input pins.\n    mov P1,#080h        ; Keep Covox centered during initialization.\n    mov 032h,#0\n    setb 0B6h           ; /RD high: ADC data bus disabled.\n    setb 0B5h           ; /WR high.\n    clr 0B4h            ; /CS low: select ADC.\n    mov DPTR,#ECHO_END\n    mov R4,DPL          ; Capture both bytes without HIGH/LOW directives.\n    mov R5,DPH\n    mov DPTR,#ECHO_BASE\ninitialize_buffer:\n    mov A,#080h\n    movx @DPTR,A\n    inc DPTR\n    mov A,DPH\n    cjne A,05h,initialize_buffer\n    mov A,DPL\n    cjne A,04h,initialize_buffer\n    mov DPTR,#ECHO_BASE\n    mov 032h,#1         ; Ready: the entire delay line contains silence.\nconvert:\n    clr 0B5h\n    setb 0B5h           ; Rising /WR samples microphone voltage.\nwait_adc:\n    jb 0B2h,wait_adc\n    clr 0B6h           ; /RD low: ADC drives P0.\n    mov A,P0\n    mov 030h,A         ; Preserve dry byte for inspection.\n    clr C\n    rrc A              ; Logical input >> 1; RR would rotate bit 0 into bit 7.\n    mov R7,A\n    movx A,@DPTR       ; Read the delayed mixed output at this pointer.\n    clr C\n    rrc A              ; Logical delayed byte >> 1.\n    add A,R7           ; Sum is 0..254, so it cannot overflow.\n    movx @DPTR,A       ; Feed the mixed result back into the same slot.\n    mov P1,A           ; Send the same mixed byte to Covox.\n    mov 031h,A\n    setb 0B6h           ; Release ADC bus.\n    inc DPTR\n    mov A,DPH\n    cjne A,05h,convert\n    mov A,DPL\n    cjne A,04h,convert\n    mov DPTR,#ECHO_BASE ; Wrap after BUFFER_SIZE samples (any size, not just powers of two).\n    sjmp convert\nend\n"}],"reload_program":"","reload_binary_address":0,"editor":{"present":true,"open":true,"draft":true,"path":"","name":"microphone_covox.asm","base_directory":".","text":"; SPDX-License-Identifier: GPL-2.0-only\n; Microphone -> ADC0804 -> P0 -> circular echo buffer -> P1 -> Covox.\n; Use the microphone preset/project: 3 MHz crystal, Cycle exact, 8051 bank 0.\n; P3.4 = /CS, P3.5 = /WR, P3.6 = /RD, P3.2 = /INTR.\n; Each output = (input >> 1) + (old buffer byte >> 1), with logical shifts.\n; IRAM 30h = dry input, 31h = mixed output, 32h = buffer initialized flag.\n; DPTR = circular pointer; R4/R5 = exclusive end address; R7 = half input.\n; Silence is unsigned 80h. Initialize the delay line to silence, not zero.\n$MOD51\nECHO_BASE EQU 08000h\nBUFFER_SIZE EQU 4096     ; Delay in samples: change this (1..32767 bytes).\nECHO_END EQU ECHO_BASE+BUFFER_SIZE\norg 0\n    mov P0,#0FFh        ; Release all ADC input pins.\n    mov P1,#080h        ; Keep Covox centered during initialization.\n    mov 032h,#0\n    setb 0B6h           ; /RD high: ADC data bus disabled.\n    setb 0B5h           ; /WR high.\n    clr 0B4h            ; /CS low: select ADC.\n    mov DPTR,#ECHO_END\n    mov R4,DPL          ; Capture both bytes without HIGH/LOW directives.\n    mov R5,DPH\n    mov DPTR,#ECHO_BASE\ninitialize_buffer:\n    mov A,#080h\n    movx @DPTR,A\n    inc DPTR\n    mov A,DPH\n    cjne A,05h,initialize_buffer\n    mov A,DPL\n    cjne A,04h,initialize_buffer\n    mov DPTR,#ECHO_BASE\n    mov 032h,#1         ; Ready: the entire delay line contains silence.\nconvert:\n    clr 0B5h\n    setb 0B5h           ; Rising /WR samples microphone voltage.\nwait_adc:\n    jb 0B2h,wait_adc\n    clr 0B6h           ; /RD low: ADC drives P0.\n    mov A,P0\n    mov 030h,A         ; Preserve dry byte for inspection.\n    clr C\n    rrc A              ; Logical input >> 1; RR would rotate bit 0 into bit 7.\n    mov R7,A\n    movx A,@DPTR       ; Read the delayed mixed output at this pointer.\n    clr C\n    rrc A              ; Logical delayed byte >> 1.\n    add A,R7           ; Sum is 0..254, so it cannot overflow.\n    movx @DPTR,A       ; Feed the mixed result back into the same slot.\n    mov P1,A           ; Send the same mixed byte to Covox.\n    mov 031h,A\n    setb 0B6h           ; Release ADC bus.\n    inc DPTR\n    mov A,DPH\n    cjne A,05h,convert\n    mov A,DPL\n    cjne A,04h,convert\n    mov DPTR,#ECHO_BASE ; Wrap after BUFFER_SIZE samples (any size, not just powers of two).\n    sjmp convert\nend\n","line":0,"column":0},"breakpoints":[],"watchpoints":[],"watches":[]}
