# Exclude private board-specific material from git archive / source releases.
/.local export-ignore
/progs/avt.bin export-ignore
/progs/hex/avt2250.hex export-ignore
/progs/asm/demo/bios.inc export-ignore
/progs/asm/demo/const.inc export-ignore
/progs/asm/demo/mtask2250.asm export-ignore
/progs/asm/mtask2250.asm export-ignore
/progs/hex/mtask2250.hex export-ignore

# Preserve the upstream TinyBASIC source/image bytes, including mixed line endings.
/third_party/tb51/tb51.asm -text -whitespace
/third_party/tb51/tb51.hex -text -whitespace

# Preserve the pinned upstream miniaudio bytes, including its trailing spaces.
/third_party/miniaudio/miniaudio.h -text -whitespace
/third_party/miniaudio/LICENSE -text
