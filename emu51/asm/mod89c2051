EX0     BIT 0A8H
ET0     BIT 0A9H
EX1     BIT 0AAH
ET1     BIT 0ABH
ES      BIT 0ACH
EA      BIT 0AFH

; Port 3 alternate functions
RXD     BIT 0B0H
TXD     BIT 0B1H
INT0    BIT 0B2H
INT1    BIT 0B3H
T0      BIT 0B4H
T1      BIT 0B5H

; Interrupt priority
PX0     BIT 0B8H
PT0     BIT 0B9H
PX1     BIT 0BAH
PT1     BIT 0BBH
