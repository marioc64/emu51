# SPDX-License-Identifier: GPL-2.0-only
set(stage "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(identity [==[@EMU51_CODESIGN_IDENTITY@]==])
if(APPLE AND NOT identity STREQUAL "")
    set(flags --force --sign "${identity}")
    if(NOT identity STREQUAL "-")
        list(APPEND flags --options runtime --timestamp)
    endif()
    foreach(tool emu51cli emu51_asm emu51_bench)
        execute_process(COMMAND /usr/bin/codesign ${flags} "${stage}/@CMAKE_INSTALL_BINDIR@/${tool}"
            RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Signing ${tool} failed: ${result}")
        endif()
    endforeach()
    if(EXISTS "${stage}/emu51.app")
        execute_process(COMMAND /usr/bin/codesign ${flags} "${stage}/emu51.app"
            RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Signing emu51.app failed: ${result}")
        endif()
        execute_process(COMMAND /usr/bin/codesign --verify --deep --strict "${stage}/emu51.app"
            RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Bundle signature verification failed: ${result}")
        endif()
    endif()
endif()
include("@PROJECT_SOURCE_DIR@/cmake/AuditPackage.cmake")
emu51_write_manifest("${stage}")
