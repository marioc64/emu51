if(NOT DEFINED WORK_DIR OR WORK_DIR STREQUAL "")
    message(FATAL_ERROR "WORK_DIR is required")
endif()
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}/unrelated cwd")
if(DEFINED ARCHIVE)
    file(MAKE_DIRECTORY "${WORK_DIR}/extract")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${ARCHIVE}"
        WORKING_DIRECTORY "${WORK_DIR}/extract" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Archive extraction failed: ${result}")
    endif()
    file(GLOB_RECURSE manifests "${WORK_DIR}/extract/*/SHA256SUMS")
    list(LENGTH manifests count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one package manifest, found ${count}")
    endif()
    list(GET manifests 0 manifest)
    get_filename_component(root "${manifest}" DIRECTORY)
elseif(DEFINED BUILD_DIR)
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}"
        --prefix "${WORK_DIR}/install tree" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Installation failed: ${output}\n${error}")
    endif()
    file(RENAME "${WORK_DIR}/install tree" "${WORK_DIR}/relocated tree")
    set(root "${WORK_DIR}/relocated tree")
else()
    message(FATAL_ERROR "Provide BUILD_DIR or ARCHIVE")
endif()
if(NOT DEFINED BINDIR)
    set(BINDIR bin)
endif()
if(NOT DEFINED DOCDIR)
    set(DOCDIR share/doc/emu51)
endif()
if(NOT DEFINED DATADIR)
    set(DATADIR share)
endif()
if(NOT DEFINED GUI_EXPECTED)
    set(GUI_EXPECTED TRUE)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/AuditPackage.cmake")
emu51_audit_package("${root}")

# Exercise the rejection guard without modifying the staged package.
foreach(private_path IN ITEMS progs/avt.bin avt2250.hex bios.inc const.inc .local/state)
    set(guard_root "${WORK_DIR}/guard-test")
    get_filename_component(parent "${guard_root}/${private_path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(WRITE "${guard_root}/${private_path}" "private test fixture")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DPACKAGE_ROOT=${guard_root}"
        -P "${CMAKE_CURRENT_LIST_DIR}/AuditPackage.cmake"
        RESULT_VARIABLE guard_result OUTPUT_QUIET ERROR_VARIABLE guard_error)
    if(guard_result EQUAL 0 OR NOT guard_error MATCHES "Private/development file")
        message(FATAL_ERROR "Package guard failed to reject ${private_path}: ${guard_error}")
    endif()
    file(REMOVE_RECURSE "${guard_root}")
endforeach()

if(DEFINED BUILD_DIR)
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${BUILD_DIR}/CPackSourceConfig.cmake"
        RESULT_VARIABLE source_result OUTPUT_QUIET ERROR_VARIABLE source_error)
    if(source_result EQUAL 0 OR NOT source_error MATCHES "Source packaging is disabled")
        message(FATAL_ERROR "CPack source packaging was not disabled: ${source_error}")
    endif()
endif()

file(STRINGS "${root}/SHA256SUMS" sums)
set(listed SHA256SUMS)
foreach(line IN LISTS sums)
    if(NOT line MATCHES "^([0-9a-f]+)  (.+)$")
        message(FATAL_ERROR "Malformed checksum entry: ${line}")
    endif()
    set(expected "${CMAKE_MATCH_1}")
    set(path "${CMAKE_MATCH_2}")
    file(SHA256 "${root}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Checksum mismatch: ${path}")
    endif()
    list(APPEND listed "${path}")
endforeach()
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*")
list(SORT listed)
list(SORT files)
if(NOT listed STREQUAL files)
    message(FATAL_ERROR "Manifest does not match package contents")
endif()
foreach(path IN ITEMS README.md RELEASE.md THIRD_PARTY_NOTICES.md HISTORY.md LICENSE COPYRIGHT
        CONTRIBUTING.md CYCLE_ACCURATE_EXECUTION.md
        licenses/imgui/LICENSE.txt licenses/ImGuiColorTextEdit/LICENSE
        licenses/kason/LICENSE licenses/codicons/LICENSE
        licenses/portable-file-dialogs/portable-file-dialogs.COPYING licenses/glfw/COPYING.txt)
    if(NOT EXISTS "${root}/${DOCDIR}/${path}")
        message(FATAL_ERROR "Missing packaged documentation/license: ${path}")
    endif()
endforeach()
if(WIN32)
    set(suffix .exe)
else()
    set(suffix "")
endif()
file(WRITE "${WORK_DIR}/program.asm" "$mod851\norg 0\nmov P1,#055h\nloop: sjmp loop\nend\n")
execute_process(COMMAND "${root}/${BINDIR}/emu51_asm${suffix}" "${WORK_DIR}/program.asm"
    -o "${WORK_DIR}/program.bin" WORKING_DIRECTORY "${WORK_DIR}/unrelated cwd"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Relocated packaged assembler failed: ${output}\n${error}")
endif()
file(READ "${WORK_DIR}/program.bin" bytes HEX)
if(NOT bytes STREQUAL "75905580fe")
    message(FATAL_ERROR "Packaged assembler produced incorrect bytes: ${bytes}")
endif()
execute_process(COMMAND "${root}/${BINDIR}/emu51${suffix}" --steps 100 "${WORK_DIR}/program.asm"
    WORKING_DIRECTORY "${WORK_DIR}/unrelated cwd" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "instructions=100 cycles=200 PC=0003")
    message(FATAL_ERROR "Relocated runner failed: ${output}\n${error}")
endif()
execute_process(COMMAND "${root}/${BINDIR}/emu51_bench${suffix}" --steps 1000 --repeats 2
    WORKING_DIRECTORY "${WORK_DIR}/unrelated cwd" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Relocated benchmark failed: ${output}\n${error}")
endif()
if(GUI_EXPECTED)
    if(APPLE)
        set(app "${root}/emu51_imgui.app")
        foreach(path IN ITEMS Contents/MacOS/emu51_imgui Contents/Info.plist
                Contents/Resources/asm/mod851 Contents/Resources/THIRD_PARTY_NOTICES.md
                Contents/Resources/LICENSE Contents/Resources/COPYRIGHT Contents/Resources/emu51.icns
                Contents/Resources/licenses/imgui/LICENSE.txt Contents/Resources/licenses/codicons/LICENSE)
            if(NOT EXISTS "${app}/${path}")
                message(FATAL_ERROR "Missing bundle content: ${path}")
            endif()
        endforeach()
        file(READ "${app}/Contents/Info.plist" plist)
        if(NOT plist MATCHES "<key>CFBundleIconFile</key>[ \t\r\n]*<string>emu51.icns</string>")
            message(FATAL_ERROR "Bundle does not declare its application icon")
        endif()
    elseif(NOT EXISTS "${root}/${BINDIR}/emu51_imgui${suffix}")
        message(FATAL_ERROR "Missing packaged desktop executable")
    endif()
    if(UNIX AND NOT APPLE)
        if(NOT EXISTS "${root}/${DATADIR}/applications/emu51.desktop")
            message(FATAL_ERROR "Missing Linux desktop entry")
        endif()
        foreach(size IN ITEMS 16 24 32 48 64 128 256 512 1024)
            if(NOT EXISTS "${root}/${DATADIR}/icons/hicolor/${size}x${size}/apps/emu51.png")
                message(FATAL_ERROR "Missing Linux ${size}px application icon")
            endif()
        endforeach()
    endif()
endif()
message(STATUS "Package audit, checksums, notices and relocated tools passed: ${root}")
