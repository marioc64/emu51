function(emu51_audit_package root)
    file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${root}" "${root}/*")
    foreach(path IN LISTS entries)
        string(TOLOWER "${path}" lower)
        if(lower MATCHES "(^|/)(progs|\\.[^/]+)(/|$)" OR
           lower MATCHES "(^|/)(avt[^/]*|mtask2250[^/]*|bios\\.inc|const\\.inc)$")
            message(FATAL_ERROR "Private/development file in package: ${path}")
        endif()
    endforeach()
endfunction()

function(emu51_write_manifest root)
    emu51_audit_package("${root}")
    file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*")
    list(SORT files)
    file(WRITE "${root}/SHA256SUMS" "")
    foreach(path IN LISTS files)
        if(path STREQUAL "SHA256SUMS")
            continue()
        endif()
        file(SHA256 "${root}/${path}" digest)
        file(APPEND "${root}/SHA256SUMS" "${digest}  ${path}\n")
    endforeach()
endfunction()

if(DEFINED PACKAGE_ROOT)
    if(NOT IS_DIRECTORY "${PACKAGE_ROOT}")
        message(FATAL_ERROR "PACKAGE_ROOT must be an existing directory")
    endif()
    emu51_audit_package("${PACKAGE_ROOT}")
    if(WRITE_MANIFEST)
        emu51_write_manifest("${PACKAGE_ROOT}")
    endif()
endif()
